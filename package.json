{
  "name": "carborator",
  "version": "0.1.0",
  "description": "CLI tool that deploys applications to cloud platforms",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "carborator": "./carborator"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --outfile carborator src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.27.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-elastic-beanstalk": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
